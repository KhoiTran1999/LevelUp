{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/schemas/**/*",
    "api/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "public"
  ]
}
