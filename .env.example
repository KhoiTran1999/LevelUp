# AI Configuration (Compatible with OpenAI / OpenRouter / Custom AI)
USE_CUSTOM_AI=true
CUSTOM_AI_BASE_URL=https://api.openai.com/v1
CUSTOM_AI_API_KEY=your_api_key_here
CUSTOM_AI_MODEL=gpt-4o-mini
MODEL_WORKER=gpt-4o-mini
MODEL_BRAIN=gpt-4o-mini

# Redis Cloud / Upstash Connection
REDIS_URL=redis://default:password@host:port

# Google OAuth Configuration (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Admin Roles & Permissions
ADMIN_EMAILS=admin@gmail.com,guildmaster@gmail.com,tranquockhoi1999@gmail.com,khoitran200199@gmail.com
ADMIN_NICKNAMES=admin,guildmaster,khoitran,khoi tran,khôi trần
ADMIN_TOKEN=your_admin_secret_token

# -----------------------------------------------------------------------------
# Cloud Storage Options (Lưu ảnh bằng chứng nhiệm vụ - Chọn 1 trong 2)
# -----------------------------------------------------------------------------
# Option 1: Supabase Storage (100% KHÔNG CẦN THẺ - Khuyên dùng)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET_NAME=proofs

# Option 2: Cloudflare R2 Storage (Cần thêm thẻ Visa/Mastercard để kích hoạt)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=levelup-proofs
# R2_PUBLIC_URL=https://pub-yourhash.r2.dev
