{
  "name": "levelup",
  "version": "1.0.0",
  "description": "Gamified Productivity & Habit RPG with Strict AI Arbiter",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --watch",
    "build:js": "node scripts/build-client.js",
    "watch:js": "node scripts/build-client.js --watch",
    "build": "npm run build:js && npm run build:css",
    "type-check": "tsc --noEmit",
    "test": "node test/run-all.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.4.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "canvas-confetti": "^1.9.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
