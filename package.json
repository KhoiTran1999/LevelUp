{
  "name": "levelup",
  "version": "1.0.0",
  "description": "Gamified Productivity & Habit RPG with Strict AI Arbiter",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "next start",
    "start:express": "node server.js",
    "dev": "npm run build:client && next dev --turbopack",
    "dev:express": "node --watch server.js",
    "build:client": "npm run build:js && npm run build:css",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --watch",
    "build:js": "node scripts/build-client.js",
    "watch:js": "node scripts/build-client.js --watch",
    "build": "npm run build:client && next build",
    "type-check": "tsc --noEmit",
    "test": "node test/run-all.js",
    "reset-data": "node scripts/reset-data.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:import-redis": "node scripts/migrate-redis-to-postgres.js",
    "package:extension": "powershell -Command \"Compress-Archive -Path 'extension/*' -DestinationPath 'levelup-shield-v1.6.0.zip' -Force; Copy-Item -Path 'levelup-shield-v1.6.0.zip' -Destination 'public/download/levelup-shield.zip' -Force\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "ioredis": "^5.4.2",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "canvas-confetti": "^1.9.4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
