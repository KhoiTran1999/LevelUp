{
  "name": "levelup",
  "version": "1.0.0",
  "description": "Gamified Productivity & Habit RPG with Strict AI Arbiter",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.min.css --watch",
    "build": "npm run build:css",
    "test": "node test/run-all.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
